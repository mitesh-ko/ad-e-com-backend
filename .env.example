# Server Configuration
NODE_ENV=development
TZ=UTC
PORT=4000
HOST=0.0.0.0

APP_NAME=ad-e-com-backend
API_PREFIX=/api/v1

# Security & CORS
# JSON array of origins or comma-separated string
CORS_ORIGIN=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication & JWT
JWT_ACCESS_SECRET=your_super_secret_enterprise_access_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_enterprise_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/ad_e_com
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10
MONGO_TIMEOUT_MS=10000

# Redis Cache & Sessions
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# Logging (Pino)
LOG_LEVEL=debug