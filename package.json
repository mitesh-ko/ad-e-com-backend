{
  "name": "ad-e-com-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade high-scale 3-Tier Express TypeScript backend with MongoDB, Redis, JWT auth, and Docker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:create": "migrate-mongo create",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:status": "migrate-mongo status",
    "seed": "tsx src/database/seeds/index.ts",
    "seed:reset": "tsx src/database/seeds/index.ts --reset",
    "db:setup": "npm run migrate:up && npm run seed"
  },
  "imports": {
    "#src/*": "./src/*.js",
    "#config/*": "./src/config/*.js",
    "#constants/*": "./src/constants/*.js",
    "#database/*": "./src/database/*.js",
    "#errors/*": "./src/errors/*.js",
    "#middlewares/*": "./src/middlewares/*.js",
    "#modules/*": "./src/modules/*.js",
    "#shared/*": "./src/shared/*.js",
    "#types/*": "./src/@types/*.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.2",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.27.0",
    "migrate-mongo": "^12.1.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
